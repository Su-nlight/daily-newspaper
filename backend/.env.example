# Copy this file to .env (in this backend/ folder) and fill in real values.
# Never commit .env.

# Required for any actual chat response. Without it, /api/chat and
# /api/chat/stream still work — they return a clear "not configured"
# message instead of crashing (see app/services/llm.py).
GROQ_API_KEY=

# Any model your Groq account can use. Keep this as the only place a model
# name is configured — see app/config.py. Check current access at
# https://console.groq.com/docs/models (some models, like
# llama-3.3-70b-versatile, are Enterprise/contact-sales only and 404 for a
# standard developer key).
GROQ_MODEL=openai/gpt-oss-20b

GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_TOKENS=800
GROQ_TEMPERATURE=0.3

# Comma-separated origins allowed to call this API.
CORS_ALLOW_ORIGINS=http://localhost:3000

ENVIRONMENT=development
