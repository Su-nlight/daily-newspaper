# Copy this file to .env (in this backend/ folder) and fill in real values.
# Never commit .env.

# Required for any actual chat response. Without it, /api/chat and
# /api/chat/stream still work — they return a clear "not configured"
# message instead of crashing (see app/services/llm.py).
GROQ_API_KEY=

# Any model your Groq account can use. Keep this as the only place a model
# name is configured — see app/config.py. Check current access at
# https://console.groq.com/docs/models (some models, like
# llama-3.3-70b-versatile, are Enterprise/contact-sales only and 404 for a
# standard developer key).
GROQ_MODEL=openai/gpt-oss-20b

GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_TOKENS=800
GROQ_TEMPERATURE=0.3

# Comma-separated origins allowed to call this API.
CORS_ALLOW_ORIGINS=http://localhost:3000

ENVIRONMENT=development

# --- Module 09: news and daily edition pipeline ------------------------------
# SQLite file for fetched articles, story clusters and editions. Relative paths
# resolve against backend/. The server and the scheduled CLI must share it.
DATABASE_PATH=app/data/daily_signal.db

# auto     = generated content once an edition exists, else the seed corpus
# pipeline = generated content only (recommended once the frontend is cut over)
# seed     = the committed mock corpus only
CONTENT_SOURCE=auto

# Summaries come from the LLM (grounded + verified) when GROQ_API_KEY is set;
# otherwise deterministic extractive summaries are used.
PIPELINE_USE_LLM=true
PIPELINE_MAX_LLM_STORIES=20
PIPELINE_LOOKBACK_HOURS=72
PIPELINE_RETENTION_DAYS=90

# Which day "today's edition" belongs to (IANA name), and the regions the
# shared front page favours (comma-separated region ids).
EDITION_TIMEZONE=UTC
EDITION_REGIONS=global

# Optional source credentials (sources reference these by name in
# app/data/pipeline_sources.json). NEWSAPI_KEY is required by the newsapi source
# (disabled by default); the other two only raise rate limits.
NEWSAPI_KEY=
NVD_API_KEY=
GITHUB_TOKEN=
